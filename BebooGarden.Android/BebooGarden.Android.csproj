<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The Android head. It holds no game logic at all - that is BebooGarden.Core, compiled once and
	  shared with the Windows build. What lives here is only what a phone does differently: the
	  activity and its lifecycle, the system text-to-speech engine, touch instead of a keyboard,
	  notifications, audio focus, and unpacking the shipped sounds out of the package.

	  FMOD is not one of those. Its C# bindings are plain P/Invoke against "fmod", which Android
	  resolves to libfmod.so out of the apk's own native library directory, so the same
	  SoundSystem serves both platforms with nothing to configure here.
	-->

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<RootNamespace>BebooGarden.Droid</RootNamespace>
		<ApplicationId>com.patricusprod.beboo.enhanced</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>3.0.0</ApplicationDisplayVersion>
		<Product>Beboo Garden: Enhanced Edition</Product>
		<Company>Saladeuh</Company>
		<!-- Mods are loaded with Assembly.LoadFrom at run time, which full AOT and trimming would
		     break. The game is not CPU-bound - it draws nothing - so there is nothing to win here
		     that would be worth losing mods over. -->
		<RunAOTCompilation>false</RunAOTCompilation>
		<PublishTrimmed>false</PublishTrimmed>
		<!--
		  Marshal methods generate the JNI registrations ahead of time, and twice now they have
		  silently failed to cover a type: once when fmod.jar was added as a bound library, and
		  again on adding a second View subclass. Both times every launch died with

		    UnsatisfiedLinkError: No implementation found for MainActivity.n_onCreate

		  before a line of managed code ran - so no crash log, no speech, nothing to go on but a
		  splash screen and a dead process. The classic reflection-based registration is slightly
		  slower to start and has not once been wrong. A game that draws nothing can afford that.
		-->
		<AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
	</PropertyGroup>


	<ItemGroup>
		<ProjectReference Include="..\BebooGarden.Core\BebooGarden.Core.csproj" />
		<ProjectReference Include="..\BebooGarden.ModApi\BebooGarden.ModApi.csproj" />
	</ItemGroup>

	<!--
	  FMOD's Android side, fetched by download_deps.bat rather than committed - the licence does
	  not allow redistributing it. It comes in two halves, and it took a crash on a real phone to
	  find that out:

	    lib/<abi>/libfmod.so   the engine. Needs no item group: the Android SDK already globs
	                          lib/<abi>/*.so into AndroidNativeLibrary, and listing them again
	                          only earns XA4301 for every file.

	    lib/android/fmod.jar  org.fmod.FMOD, which must be handed the Context before any system
	                          can be created - that is how FMOD reaches the audio device and the
	                          asset manager. Without it System_Create returns ERR_INTERNAL and
	                          says nothing else. Bind=false on purpose: generating a C# binding
	                          for it stopped the activity's JNI methods being registered at all,
	                          so every launch died with UnsatisfiedLinkError on n_onCreate before
	                          any managed code ran. The jar still ships, putting the classes in
	                          the dex, and FmodJava calls them through JNI by name.

	  Conditioned so the project still builds with neither present: everything except the audio
	  can be worked on without them.
	-->
	<ItemGroup Condition="Exists('lib\android\fmod.jar')">
		<AndroidLibrary Include="lib\android\fmod.jar" Bind="false" />
	</ItemGroup>

	<!--
	  The sounds ship as ONE zip asset, unpacked on first run - see AndroidStorage.

	  Not as 520 separate AndroidAssets, for two reasons. aapt2 cannot open an asset path that is not
	  ASCII, and the music box rolls are named things like "1812 Overture (Finale)&#x29F8;- Tchaikovsky.mp3"
	  - that character is a big solidus standing in for the slash a filename is not allowed to
	  contain. Packaging them one at a time also made aapt2 walk half a gigabyte of files it had
	  nothing to do to. A zip sidesteps both, keeps every name exactly as it is, and unpacks faster.
	-->
	<Target Name="PackBebooContent" BeforeTargets="BeforeBuild">
		<!-- Inside the target, not in a PropertyGroup above it. IntermediateOutputPath is set by an
		     SDK import that is evaluated after this file, so up there it is still empty and both of
		     these resolve to the project directory - which quietly drops half a gigabyte of staged
		     audio next to the source and offers it all to git. -->
		<PropertyGroup>
			<BebooContentSource>..\BebooGarden\Content</BebooContentSource>
			<BebooContentStage>$(IntermediateOutputPath)content-stage\</BebooContentStage>
			<BebooContentZip>$(IntermediateOutputPath)content.zip</BebooContentZip>
		</PropertyGroup>
		<ItemGroup>
			<!-- Excluded: leftovers from the MonoGame content pipeline that no longer runs, and the
			     translations, which are embedded in BebooGarden.Core instead. -->
			<BebooContent Include="$(BebooContentSource)\**\*.*"
			              Exclude="$(BebooContentSource)\bin\**;$(BebooContentSource)\obj\**;$(BebooContentSource)\**\*.resx;$(BebooContentSource)\**\*.cs;$(BebooContentSource)\**\*.xnb;$(BebooContentSource)\**\*.mgcontent" />
		</ItemGroup>
		<Copy SourceFiles="@(BebooContent)"
		      DestinationFiles="@(BebooContent->'$(BebooContentStage)%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
		<ZipDirectory SourceDirectory="$(BebooContentStage)"
		              DestinationFile="$(BebooContentZip)"
		              Overwrite="true" />
		<ItemGroup>
			<AndroidAsset Include="$(BebooContentZip)" Link="Assets\content.zip" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<!-- The zip holds audio that is already compressed; squeezing it again in the apk would only
		     cost install time. -->
		<AndroidStoreUncompressedFileExtensions>.zip</AndroidStoreUncompressedFileExtensions>
	</PropertyGroup>

</Project>
