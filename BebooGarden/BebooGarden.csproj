<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<Product>Beboo Garden: Enhanced Edition</Product>
		<AssemblyTitle>Beboo Garden: Enhanced Edition</AssemblyTitle>
		<Company>Saladeuh</Company>
		<!-- Assembly versions must be numeric; the name of the build is the informational
		     one, and that is what the installer and the apk show. -->
		<Version>3.0.0</Version>
		<InformationalVersion>3.0b1</InformationalVersion>
	</PropertyGroup>
	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
	</PropertyGroup>
	<PropertyGroup>
		<!-- No MonoGame content pipeline. Every sound in this game is opened by FMOD from the raw
		     file on disk, and nothing anywhere calls Content.Load, so the pipeline was transcoding
		     518 mp3s and wavs into xnb files that were never once read - three minutes a build and
		     351 MB of output that the Content item below then had to exclude from the release.
		     It also failed the build outright: 25 of those files are at sample rates or bit depths
		     MonoGame's importers refuse, which FMOD plays without complaint. -->
		<EnableMGCBItems>false</EnableMGCBItems>
	</PropertyGroup>
	<ItemGroup>
		<!-- Content/bin and Content/obj are what that pipeline used to leave behind. Still excluded:
		     the folders are on disk in existing checkouts and must not reach the release. -->
		<Content Include="Content\**" Exclude="Content\bin\**;Content\obj\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="lib\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="mods\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BebooGarden.ModApi\BebooGarden.ModApi.csproj" />
		<ProjectReference Include="..\BebooGarden.Core\BebooGarden.Core.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Icon.ico" />
		<None Remove="Icon.bmp" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Icon.ico">
			<LogicalName>Icon.ico</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icon.bmp">
			<LogicalName>Icon.bmp</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Fmod5Sharp" Version="3.0.1" />
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
		<PackageReference Include="Myra" Version="1.5.9" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="SharpHook" Version="5.3.9" />
		<PackageReference Include="TOWK.Utility.CrossSpeak" Version="1.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\AccessibleMyraUI\AccessibleMyraUI.csproj" />
	</ItemGroup>
	<!-- There was a RestoreDotnetTools target here that ran "dotnet tool restore" before every
	     restore. The only thing in .config/dotnet-tools.json is mgcb and its editors, so with the
	     content pipeline gone it was fetching a toolchain nothing runs. The manifest is left in
	     place for anyone who wants to open Content.mgcb in the editor by hand. -->
</Project>